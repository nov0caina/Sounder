<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_feed_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <org.nov0caina.sounder.ui.CoordinatorAppBarLayout
        android:id="@+id/home_feed_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        app:liftOnScroll="true">

        <org.nov0caina.sounder.ui.MultiToolbar
            android:id="@+id/home_feed_multitoolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways">

            <org.nov0caina.sounder.ui.AuxioToolbar
                android:id="@+id/home_feed_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/info_app_name"
                app:navigationIcon="@drawable/ic_sounder_logo" />

        </org.nov0caina.sounder.ui.MultiToolbar>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/home_feed_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible" />

    </org.nov0caina.sounder.ui.CoordinatorAppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_feed_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone"
            android:paddingBottom="@dimen/recycler_fab_space_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_large">

                <!-- Greeting / Header Banner -->
                <TextView
                    android:id="@+id/home_greeting_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_tiny"
                    android:text="@string/home_greeting_afternoon"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textStyle="bold" />

                <!-- 1. Hero Spotlight Section -->
                <include
                    android:id="@+id/home_hero_spotlight"
                    layout="@layout/item_home_hero_spotlight"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 2. Mood & Category Filter Chips -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_mood_chips_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_tiny"
                    android:paddingBottom="@dimen/spacing_small"
                    tools:listitem="@layout/item_home_mood_chip" />

                <!-- 3. Quick Access 2x3 Grid Section -->
                <LinearLayout
                    android:id="@+id/home_quick_access_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingBottom="@dimen/spacing_small"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/home_quick_access_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_home_quick_access" />

                </LinearLayout>

                <!-- 4. Quick Picks (Columnas Horizontales) -->
                <LinearLayout
                    android:id="@+id/quick_picks_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:text="@string/header_quick_picks"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_small"
                        android:text="@string/header_quick_picks_sub"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?android:attr/textColorSecondary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quick_picks_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        tools:listitem="@layout/item_quick_picks_column" />

                </LinearLayout>

                <!-- 5. Álbumes en Tendencia -->
                <LinearLayout
                    android:id="@+id/trending_albums_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:text="@string/header_trending_albums"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_small"
                        android:text="@string/header_trending_albums_sub"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?android:attr/textColorSecondary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trending_albums_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        tools:listitem="@layout/item_online_album_card" />

                </LinearLayout>

                <!-- 6. Artistas Populares -->
                <LinearLayout
                    android:id="@+id/popular_artists_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:text="@string/header_popular_artists"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_small"
                        android:text="@string/header_popular_artists_sub"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?android:attr/textColorSecondary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/popular_artists_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        tools:listitem="@layout/item_recent_artist" />

                </LinearLayout>

                <!-- 7. Billboard Top 5 / Top 20 -->
                <LinearLayout
                    android:id="@+id/trending_tracks_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="@dimen/spacing_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:text="@string/header_trending_tracks"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_small"
                        android:text="@string/header_trending_tracks_sub"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?android:attr/textColorSecondary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trending_tracks_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_online_track" />

                    <LinearLayout
                        android:id="@+id/trending_tracks_toggle_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/trending_tracks_toggle_btn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingEnd="4dp"
                            android:text="@string/btn_show_more_tracks" />

                        <ImageView
                            android:id="@+id/trending_tracks_toggle_chevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_down_24"
                            app:tint="?attr/colorPrimary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Loading Skeleton Layout (shown on initial load) -->
        <FrameLayout
            android:id="@+id/home_loading_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <include layout="@layout/layout_home_feed_skeleton" />

        </FrameLayout>

        <!-- Offline / Error State Layout -->
        <include
            android:id="@+id/home_offline_layout"
            layout="@layout/layout_offline_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
