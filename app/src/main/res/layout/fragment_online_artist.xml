<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <org.nov0caina.sounder.ui.CoordinatorAppBarLayout
        android:id="@+id/artist_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/artist_scroll">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/artist_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:expandedTitleMargin="0dp"
            app:forceApplySystemWindowInsetTop="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false"
            app:toolbarId="@+id/artist_toolbar">

            <org.nov0caina.sounder.playback.ui.AmbientGlowView
                android:id="@+id/artist_ambient_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:glowAnchorView="@id/artist_avatar"
                app:glowBlurRadius="48"
                app:glowShape="circle"
                app:glowSpread="48dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.85"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/artist_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="?attr/actionBarSize"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium"
                android:visibility="gone"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.85"
                tools:visibility="visible">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/artist_avatar"
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="?attr/colorSurfaceContainerHigh"
                    android:contentDescription="@null"
                    android:elevation="6dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    tools:src="@drawable/ic_artist_24" />

                <TextView
                    android:id="@+id/artist_header_name"
                    style="@style/Widget.Auxio.TextView.Item.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:maxLines="3"
                    android:textAlignment="center"
                    android:textSize="24sp"
                    tools:text="Rammstein" />

                <TextView
                    android:id="@+id/artist_header_audience"
                    style="@style/Widget.Auxio.TextView.Item.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_metadata_badge"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="16.9M monthly audience"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Primary Accent Play Capsule -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/artist_play_button"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:paddingStart="24dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="0dp"
                        android:text="@string/btn_play"
                        android:textSize="15sp"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_play_24"
                        app:iconSize="20dp" />

                    <!-- Circular Glass Shuffle Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/artist_shuffle_button"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/lbl_shuffle"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_shuffle_off_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="22dp" />

                    <!-- Circular Glass Favorite Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/artist_favorite_button"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/lbl_add_favorite"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_favorite_border_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="22dp" />

                </LinearLayout>

            </LinearLayout>

            <org.nov0caina.sounder.ui.AuxioToolbar
                android:id="@+id/artist_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back_24"
                tools:title="Rammstein" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/artist_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

    </org.nov0caina.sounder.ui.CoordinatorAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/artist_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/recycler_fab_space_normal"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Glassmorphic Expandable Biography Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/artist_description_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_tiny"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.06"
                                android:text="@string/lbl_about"
                                android:textAllCaps="true"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <ImageView
                                android:id="@+id/artist_description_chevron"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:alpha="0.7"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_down_24"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/artist_description"
                            style="@style/Widget.Auxio.TextView.Item.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="4"
                            android:textSize="14sp"
                            tools:text="Legendary German industrial metal band formed in 1994." />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Top Songs Section -->
            <LinearLayout
                android:id="@+id/artist_top_songs_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_medium">

                <TextView
                    style="@style/Widget.Auxio.TextView.Item.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_tiny"
                    android:text="@string/header_songs"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/artist_top_songs_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_online_track" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/artist_top_songs_toggle_btn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:text="@string/btn_show_more_tracks"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Albums Section -->
            <LinearLayout
                android:id="@+id/artist_albums_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_small"
                    android:paddingBottom="@dimen/spacing_tiny">

                    <TextView
                        android:id="@+id/artist_albums_header"
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/header_albums"
                        android:textSize="18sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/artist_albums_view_toggle_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="0dp"
                        android:text="@string/btn_view_grid"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_grid_view_24"
                        app:iconSize="18dp"
                        tools:visibility="visible" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/artist_albums_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_online_album_card" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/artist_albums_expand_btn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/btn_show_more"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Singles & EPs Section -->
            <LinearLayout
                android:id="@+id/artist_singles_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_small"
                    android:paddingBottom="@dimen/spacing_tiny">

                    <TextView
                        android:id="@+id/artist_singles_header"
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/header_singles"
                        android:textSize="18sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/artist_singles_view_toggle_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="0dp"
                        android:text="@string/btn_view_grid"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_grid_view_24"
                        app:iconSize="18dp"
                        tools:visibility="visible" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/artist_singles_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_online_album_card" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/artist_singles_expand_btn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/btn_show_more"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Related Artists Section -->
            <LinearLayout
                android:id="@+id/artist_related_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium">

                <TextView
                    style="@style/Widget.Auxio.TextView.Item.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_tiny"
                    android:text="@string/header_related_artists"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/artist_related_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_recent_artist" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Skeleton Layout -->
    <FrameLayout
        android:id="@+id/artist_loading_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <include layout="@layout/layout_online_artist_skeleton" />

    </FrameLayout>

    <!-- Offline State Layout -->
    <include
        android:id="@+id/artist_offline_layout"
        layout="@layout/layout_offline_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

