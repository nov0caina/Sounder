<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <org.nov0caina.sounder.playback.ui.AmbientGlowView
            android:id="@+id/top_pick_ambient_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:glowAnchorView="@id/top_pick_image"
            app:glowAnimateTransitions="false"
            app:glowBlurRadius="32"
            app:glowShape="rect"
            app:glowSpread="18dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/top_pick_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/colorSurfaceContainerHighest"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="16:10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            tools:src="@drawable/ic_song_24" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/top_pick_loading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorSize="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/top_pick_image"
            app:layout_constraintEnd_toEndOf="@+id/top_pick_image"
            app:layout_constraintStart_toStartOf="@+id/top_pick_image"
            app:layout_constraintTop_toTopOf="@+id/top_pick_image"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/top_pick_title"
            style="@style/Widget.Auxio.TextView.Item.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_pick_image"
            tools:text="Master of Puppets" />

        <TextView
            android:id="@+id/top_pick_artist"
            style="@style/Widget.Auxio.TextView.Item.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_pick_title"
            tools:text="Metallica" />

        <TextView
            android:id="@+id/top_pick_duration"
            style="@style/Widget.Auxio.TextView.Item.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@+id/top_pick_download_button"
            app:layout_constraintEnd_toStartOf="@+id/top_pick_download_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_pick_download_button"
            tools:text="8:35" />

        <org.nov0caina.sounder.ui.RippleFixMaterialButton
            android:id="@+id/top_pick_download_button"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/btn_download"
            app:icon="@drawable/ic_download_24"
            app:iconSize="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/top_pick_menu_button"
            app:layout_constraintTop_toBottomOf="@+id/top_pick_artist" />

        <org.nov0caina.sounder.ui.RippleFixMaterialButton
            android:id="@+id/top_pick_menu_button"
            style="@style/Widget.Auxio.Button.Icon.Small"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/desc_song_options"
            app:icon="@drawable/ic_more_vert_24"
            app:iconSize="18dp"
            app:layout_constraintBottom_toBottomOf="@+id/top_pick_download_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_pick_download_button" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
