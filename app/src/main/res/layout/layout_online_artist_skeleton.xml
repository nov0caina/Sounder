<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeleton_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_large">

    <!-- Hero Banner Skeleton (220dp) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- Artist Name Silhouette -->
            <View
                android:layout_width="180dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

    </FrameLayout>

    <!-- Play Action & Bio Description Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium">

        <!-- Play Button Silhouette -->
        <View
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <!-- 4-Line Bio Description Silhouettes -->
        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="150dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Top Songs Header Skeleton -->
    <View
        android:layout_width="70dp"
        android:layout_height="18dp"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_tiny"
        android:background="@drawable/bg_skeleton_placeholder" />

    <!-- Top Song Item 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="150dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="100dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Top Song Item 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="170dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="110dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Top Song Item 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="130dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="85dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Top Song Item 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="160dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="105dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Top Song Item 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="95dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

</LinearLayout>
