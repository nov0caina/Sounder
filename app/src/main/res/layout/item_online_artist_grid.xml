<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="0dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <org.nov0caina.sounder.playback.ui.AmbientGlowView
            android:id="@+id/artist_ambient_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:glowAnchorView="@id/artist_avatar"
            app:glowAnimateTransitions="false"
            app:glowBlurRadius="26"
            app:glowSpread="14dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/artist_avatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="?attr/colorSurfaceContainerHigh"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1.5dp"
            tools:src="@drawable/ic_artist_24" />

    </FrameLayout>

    <TextView
        android:id="@+id/artist_name"
        style="@style/Widget.Auxio.TextView.Item.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="13sp"
        tools:text="Metallica" />

    <TextView
        android:id="@+id/artist_subtitle"
        style="@style/Widget.Auxio.TextView.Item.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="11sp"
        tools:text="75.8M monthly audience" />

</LinearLayout>
