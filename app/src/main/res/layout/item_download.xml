<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_item_bg"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_mid_medium"
    android:paddingEnd="@dimen/spacing_small"
    android:paddingBottom="@dimen/spacing_mid_medium">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/download_item_image"
        android:layout_width="@dimen/size_touchable_small"
        android:layout_height="@dimen/size_touchable_small"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_download_24"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/download_item_title"
        style="@style/Widget.Auxio.TextView.Item.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_small"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/download_item_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/download_item_cancel"
        app:layout_constraintStart_toEndOf="@+id/download_item_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Downloading Song Title" />

    <TextView
        android:id="@+id/download_item_subtitle"
        style="@style/Widget.Auxio.TextView.Item.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_small"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/download_item_progress"
        app:layout_constraintEnd_toStartOf="@+id/download_item_cancel"
        app:layout_constraintStart_toEndOf="@+id/download_item_image"
        app:layout_constraintTop_toBottomOf="@+id/download_item_title"
        tools:text="Artist • 45%" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/download_item_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:layout_marginEnd="@dimen/spacing_small"
        android:max="100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/download_item_cancel"
        app:layout_constraintStart_toEndOf="@+id/download_item_image"
        app:layout_constraintTop_toBottomOf="@+id/download_item_subtitle"
        tools:progress="45" />

    <org.nov0caina.sounder.ui.RippleFixMaterialButton
        android:id="@+id/download_item_cancel"
        style="@style/Widget.Auxio.Button.Icon.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/lbl_cancel"
        app:icon="@drawable/ic_close_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

