<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeleton_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_large">

    <!-- Album Header Section Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium">

        <!-- Centered Album Artwork Silhouette -->
        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <!-- Title Silhouette -->
        <View
            android:layout_width="160dp"
            android:layout_height="22dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_skeleton_placeholder" />

        <!-- Artist Silhouette -->
        <View
            android:layout_width="110dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <!-- Info / Year • Songs Silhouette -->
        <View
            android:layout_width="90dp"
            android:layout_height="13dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <!-- Action Buttons Silhouette (Play & Download) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

    </LinearLayout>

    <!-- Tracklist Header Skeleton -->
    <View
        android:layout_width="70dp"
        android:layout_height="18dp"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_tiny"
        android:background="@drawable/bg_skeleton_placeholder" />

    <!-- Track Item 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="160dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="110dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Track Item 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="95dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Track Item 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="180dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="120dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Track Item 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="130dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="90dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

    <!-- Track Item 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="150dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_placeholder" />

            <View
                android:layout_width="105dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_placeholder" />

        </LinearLayout>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_skeleton_placeholder" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_placeholder" />

    </LinearLayout>

</LinearLayout>
