<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/discover_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <org.nov0caina.sounder.ui.CoordinatorAppBarLayout
        android:id="@+id/discover_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        app:liftOnScroll="true">

        <org.nov0caina.sounder.ui.MultiToolbar
            android:id="@+id/discover_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways">

            <org.nov0caina.sounder.ui.AuxioToolbar
                android:id="@+id/discover_normal_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:navigationIcon="@drawable/ic_search_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/discover_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:background="@drawable/bg_search_pill"
                    android:hint="@string/search_online_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

            </org.nov0caina.sounder.ui.AuxioToolbar>

        </org.nov0caina.sounder.ui.MultiToolbar>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/discover_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible" />

    </org.nov0caina.sounder.ui.CoordinatorAppBarLayout>

    <FrameLayout
        android:id="@+id/discover_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- Discover Home (Active when search is idle) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/discover_home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/recycler_fab_space_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_large">

                <!-- Quick Discovery Mood Chips Row -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/discover_moods_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_tiny"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_home_mood_chip" />

                <!-- Recent Artists Section -->
                <LinearLayout
                    android:id="@+id/recent_artists_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/recent_artists_header"
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_small"
                        android:text="@string/recent_artists"
                        android:textSize="18sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recent_artists_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_recent_artist" />

                </LinearLayout>

                <!-- Genres Section -->
                <TextView
                    android:id="@+id/genres_header"
                    style="@style/Widget.Auxio.TextView.Item.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_small"
                    android:text="@string/explore_genres"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/genres_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"
                    tools:itemCount="6"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_genre_card"
                    tools:spanCount="2" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Search Results (Active when searching) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/discover_results_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/recycler_fab_space_normal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Category Filter Chips -->
                <LinearLayout
                    android:id="@+id/results_filter_chips_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_small">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filter_chip_all"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/lbl_filter_all"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filter_chip_artists"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/header_artists"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filter_chip_songs"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/header_songs"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                </LinearLayout>

                <!-- Top Result (Best Match) Hero Spotlight -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/top_result_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.08"
                            android:text="@string/header_top_result"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/top_result_avatar"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="?attr/colorSurfaceVariant"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                app:strokeWidth="1.5dp"
                                app:strokeColor="?attr/colorPrimary"
                                tools:src="@drawable/ic_artist_24" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/top_result_title"
                                    style="@style/Widget.Auxio.TextView.Item.Primary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="18sp"
                                    tools:text="Metallica" />

                                <TextView
                                    android:id="@+id/top_result_subtitle"
                                    style="@style/Widget.Auxio.TextView.Item.Secondary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="13sp"
                                    tools:text="64.6M monthly audience" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/top_result_play_btn"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/btn_play"
                                app:cornerRadius="19dp"
                                app:icon="@drawable/ic_play_24"
                                app:iconSize="18dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/top_result_explore_btn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/btn_explore_artist"
                                app:cornerRadius="19dp"
                                app:icon="@drawable/ic_chevron_right_24"
                                app:iconGravity="end"
                                app:iconSize="18dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Expansive Related Artists Shelf (Visible in All tab) -->
                <LinearLayout
                    android:id="@+id/results_related_artists_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_tiny"
                        android:text="@string/header_related_artists"
                        android:textSize="17sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/results_related_artists_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_recent_artist" />

                </LinearLayout>

                <!-- Artists Results Section (Full List when Artists tab is selected) -->
                <LinearLayout
                    android:id="@+id/results_artists_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_tiny"
                        android:text="@string/header_artists"
                        android:textSize="17sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/results_artists_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_online_artist" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/results_artists_toggle_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/btn_show_more_artists"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Tracks Results Section -->
                <LinearLayout
                    android:id="@+id/results_tracks_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/results_tracks_header"
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_tiny"
                        android:text="@string/header_songs"
                        android:textSize="17sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/discover_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_online_track" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/results_tracks_toggle_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/btn_show_more_tracks"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Empty / No Results State -->
        <LinearLayout
            android:id="@+id/discover_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_explore_24"
                app:tint="?attr/colorOutline" />

            <TextView
                android:id="@+id/discover_empty_message"
                style="@style/Widget.Auxio.TextView.Item.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/no_results_found"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Offline State Layout -->
        <include
            android:id="@+id/discover_offline_layout"
            layout="@layout/layout_offline_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Loading Skeleton Layout (Active when search query is executing) -->
        <FrameLayout
            android:id="@+id/discover_loading_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <include layout="@layout/layout_discover_skeleton" />

        </FrameLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
