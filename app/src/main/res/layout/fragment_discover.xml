<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/discover_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <org.nov0caina.sounder.ui.CoordinatorAppBarLayout
        android:id="@+id/discover_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        app:liftOnScroll="true">

        <org.nov0caina.sounder.ui.MultiToolbar
            android:id="@+id/discover_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways">

            <org.nov0caina.sounder.ui.AuxioToolbar
                android:id="@+id/discover_normal_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:navigationIcon="@drawable/ic_search_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/discover_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:background="@drawable/bg_search_pill"
                    android:hint="@string/search_online_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

            </org.nov0caina.sounder.ui.AuxioToolbar>

        </org.nov0caina.sounder.ui.MultiToolbar>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/discover_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible" />

    </org.nov0caina.sounder.ui.CoordinatorAppBarLayout>

    <LinearLayout
        android:id="@+id/discover_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- Contextual Active Category / Mood Header -->
        <LinearLayout
            android:id="@+id/discover_category_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <org.nov0caina.sounder.ui.RippleFixMaterialButton
                android:id="@+id/discover_category_back_btn"
                style="@style/Widget.Auxio.Button.Icon.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_navigate_back"
                app:icon="@drawable/ic_back_24" />

            <TextView
                android:id="@+id/discover_category_title"
                style="@style/Widget.Auxio.TextView.Item.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textSize="20sp"
                tools:text="Metal" />

        </LinearLayout>

        <!-- Pinned Category Filter Chips (Visible with results) -->
        <LinearLayout
            android:id="@+id/results_filter_chips_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_chip_all"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/lbl_filter_all"
                android:textSize="13sp"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_chip_artists"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/header_artists"
                android:textSize="13sp"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_chip_songs"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/header_songs"
                android:textSize="13sp"
                app:cornerRadius="18dp" />

        </LinearLayout>

        <!-- Fixed Action Header Bar for Songs Filter -->
        <LinearLayout
            android:id="@+id/results_songs_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/results_songs_count_header"
                style="@style/Widget.Auxio.TextView.Item.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:text="@string/header_songs"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/results_songs_play_all_btn"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="sans-serif-bold"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/btn_play_all"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play_24"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/results_songs_shuffle_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/btn_shuffle_play"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_shortcut_shuffle_24"
                app:iconSize="16dp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/discover_state_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

        <!-- Discover Home (Active when search is idle) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/discover_home_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/discover_home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/recycler_fab_space_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_large">

                <!-- Quick Discovery Mood Chips Row -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/discover_moods_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_tiny"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_home_mood_chip" />

                <!-- Recent Artists Section -->
                <LinearLayout
                    android:id="@+id/recent_artists_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/recent_artists_header"
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_small"
                        android:text="@string/recent_artists"
                        android:textSize="18sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recent_artists_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_recent_artist" />

                </LinearLayout>

                <!-- Genres Section -->
                <TextView
                    android:id="@+id/genres_header"
                    style="@style/Widget.Auxio.TextView.Item.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_small"
                    android:text="@string/explore_genres"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/genres_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"
                    tools:itemCount="6"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_genre_card"
                    tools:spanCount="2" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Search Results (Active when searching) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/discover_results_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

        <FrameLayout
            android:id="@+id/discover_results_tabs_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/discover_results_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/recycler_fab_space_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Top Result (Best Match) Hero Spotlight -->
                <include
                    android:id="@+id/top_result_card"
                    layout="@layout/item_discover_top_result"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Expansive Related Artists Shelf (Visible in All tab) -->
                <LinearLayout
                    android:id="@+id/results_related_artists_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_tiny"
                        android:text="@string/header_related_artists"
                        android:textSize="17sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/results_related_artists_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_recent_artist" />

                </LinearLayout>

                <!-- Tracks Results Section (Visible in All tab) -->
                <LinearLayout
                    android:id="@+id/results_tracks_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/results_tracks_header"
                        style="@style/Widget.Auxio.TextView.Item.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingBottom="@dimen/spacing_tiny"
                        android:text="@string/header_songs"
                        android:textSize="17sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/discover_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_online_track" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/results_tracks_toggle_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/btn_show_more_tracks"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Tab 2: Recycling 3-Column Artists Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discover_artists_tab_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/recycler_fab_space_normal"
            android:visibility="gone" />

        <!-- Tab 3: Recycling Hybrid Top Picks + Compact More Songs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discover_songs_tab_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/recycler_fab_space_normal"
            android:visibility="gone" />

        </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Empty / No Results State -->
        <LinearLayout
            android:id="@+id/discover_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_explore_24"
                app:tint="?attr/colorOutline" />

            <TextView
                android:id="@+id/discover_empty_message"
                style="@style/Widget.Auxio.TextView.Item.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/no_results_found"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Offline State Layout -->
        <include
            android:id="@+id/discover_offline_layout"
            layout="@layout/layout_offline_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Loading Skeleton Layout (Active when search query is executing) -->
        <FrameLayout
            android:id="@+id/discover_loading_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <include layout="@layout/layout_discover_skeleton" />

        </FrameLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
