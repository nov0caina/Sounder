<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <include
        android:id="@+id/offline_backup_content"
        layout="@layout/layout_offline_backup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.nov0caina.sounder.ui.EdgeFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/offline_backup_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium"
            android:visibility="invisible">

            <org.nov0caina.sounder.home.list.CookieImageView
                android:id="@+id/offline_backup_empty_icon"
                android:layout_width="@dimen/size_fast_scroll_popup"
                android:layout_height="@dimen/size_fast_scroll_popup"
                android:layout_marginBottom="@dimen/spacing_small"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:src="@drawable/ic_song_48"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/offline_backup_empty_msg"
                android:layout_width="256dp"
                android:layout_height="wrap_content"
                android:text="@string/lng_empty_offline_backup"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

        </LinearLayout>

    </org.nov0caina.sounder.ui.EdgeFrameLayout>

</FrameLayout>
